{
  "manifest_version": 3,
  "name": "Auction Helper",
  "version": "1.6.0",
  "description": "A manual YoWorld auction organizer with screenshot-ready lot galleries, image repair, bundle covers, history, and exports.",
  "permissions": [
    "storage",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.yoworld.info/*",
    "https://yw-web.yoworld.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Auction Helper"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
